# Postgres connection used by the API container
DATABASE_URL=postgresql://cvas:cvas@db:5432/cvas

# Local media storage path (swap for S3-compatible client in production)
MEDIA_ROOT=/app/uploads

# Decision engine thresholds (tenant defaults — override per tenant in future)
AUTO_APPROVE_THRESHOLD=0.80
AUTO_REJECT_THRESHOLD=0.25

# Placeholder for future real model integration
LLM_API_KEY=
VISION_API_KEY=
